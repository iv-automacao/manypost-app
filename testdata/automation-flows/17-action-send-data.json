    "edges": [
      { "id": "e1", "source": "opening", "sourceHandle": "next", "target": "nome" },
      { "id": "e2", "source": "nome", "sourceHandle": "next", "target": "dados" },
      { "id": "e3", "source": "dados", "sourceHandle": "next", "target": "fim" }
